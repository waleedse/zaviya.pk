# PostgreSQL
DATABASE_URL=postgres://zaviya:zaviya@localhost:5432/zaviya

# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site URL (canonical, sitemaps, IndexNow)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Cloudflare R2 (optional — media uploads use local disk when unset)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# On-demand revalidation (frontend API routes)
REVALIDATE_SECRET=

# IndexNow (optional — pings search engines on first publish)
INDEXNOW_KEY=

# Google AdSense — leave empty until approved (no ad slots render while empty)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Web Push (optional — generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:editor@zaviya.pk

# Third-party analytics (optional — only injected when set)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# Seed script defaults
SEED_ADMIN_EMAIL=admin@zaviya.pk
SEED_ADMIN_PASSWORD=change-me-now-123

# WhatsApp channel invite link (CTA is hidden while empty)
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=

# Google Search Console (service account JSON on one line, site like sc-domain:zaviya.pk)
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=

# Max automated articles per day (pacing for quality)
DAILY_ARTICLE_CAP=60

# Show invented demo stories/rates when the DB is empty — local demos only, never in production
ZAVIYA_DEMO_DATA=

# Production only (docker compose): Postgres password
POSTGRES_PASSWORD=

# Urdu edition (links, sitemap, indexing). Off while the site is English-only.
NEXT_PUBLIC_URDU_ENABLED=false
