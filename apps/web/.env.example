# PostgreSQL
DATABASE_URL=postgres://zaviya:zaviya@localhost:5432/zaviya

# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site URL (canonical, sitemaps, IndexNow)
