NODE_ENV=development
# Web app URL (https://zaviya.pk in production)
PAYLOAD_URL=http://localhost:3100
PAYLOAD_API_KEY=
REDIS_URL=redis://localhost:6379
OLLAMA_URL=http://127.0.0.1:11434
# Free-tier key from aistudio.google.com: used for writing (models rotate when one runs out)
GEMINI_API_KEY=
SEARXNG_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
META_PAGE_ID=
META_PAGE_TOKEN=
IG_USER_ID=
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_CURATED_USER_IDS=
BRIDGE_PORT=8787
BRIDGE_TOKEN=zaviya-dev-bridge
GOLD_API_URL=
WORKER_VERSION=0.1.0
LOG_LEVEL=info
# Local model (Ollama) for triage/SEO/QA and as the writing fallback
LOCAL_MODEL=qwen3:8b
# Outlets that must cover a story before it is considered
TRIAGE_MIN_SOURCES=2
# Browser-extension discovery (X / Instagram)
DISCOVERY_INTERVAL_MIN=20
# X searches separated by || (optional, overrides built-in list)
DISCOVERY_X_QUERIES=
# Instagram usernames, comma separated (optional)
DISCOVERY_IG_PROFILES=
# Publish without waiting for review: safe (all but blasphemy/minors) | all | off
AUTO_APPROVE=safe
# LLM work runs on Gemini's free tier only (no paid API fallback; the old LLM_API_* settings are ignored).
# Per-model budget (calls per minute / per day, tokens per minute), kept in Redis. Defaults match the free tier;
# override per model, "*" changes the default: GEMINI_LIMITS={"gemini-3.8-flash":{"rpd":500},"*":{"rpm":4}}
GEMINI_LIMITS=
# Share of a model's daily budget kept back from QA and from SEO/social (default 0.08 and 0.2)
GEMINI_RESERVE_QA=
GEMINI_RESERVE_LOW=
# Write the Urdu edition too (false while the site is English-only)
WRITE_URDU=false
# Google account (email) for gemini.google.com when several accounts are signed in to Chrome
GEMINI_WEB_ACCOUNT=
# Email commands (off unless true): Waleed mails ops@zaviya.pk; see docs/EMAIL-COMMANDS-BUILD.md
MAIL_COMMANDS_ENABLED=false
OPS_MAIL_USER=
OPS_MAIL_PASSWORD=
# Hand-offs to the agents (Linear issues)
LINEAR_API_KEY=
